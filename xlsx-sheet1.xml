<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetPr><outlinePr summaryBelow="1" summaryRight="1"/><pageSetUpPr/></sheetPr><dimension ref="A1:L22"/><sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/><selection pane="bottomLeft" activeCell="A1" sqref="A1"/></sheetView></sheetViews><sheetFormatPr baseColWidth="8" defaultRowHeight="15"/><cols><col width="7" customWidth="1" min="1" max="1"/><col width="8" customWidth="1" min="2" max="2"/><col width="9" customWidth="1" min="3" max="3"/><col width="42" customWidth="1" min="4" max="4"/><col width="46" customWidth="1" min="5" max="5"/><col width="46" customWidth="1" min="6" max="6"/><col width="40" customWidth="1" min="7" max="7"/><col width="12" customWidth="1" min="8" max="8"/><col width="14" customWidth="1" min="9" max="9"/><col width="34" customWidth="1" min="10" max="10"/><col width="22" customWidth="1" min="11" max="11"/><col width="30" customWidth="1" min="12" max="12"/></cols><sheetData><row r="1" ht="34" customHeight="1"><c r="A1" s="1" t="inlineStr"><is><t>Serial #</t></is></c><c r="B1" s="1" t="inlineStr"><is><t>Type</t></is></c><c r="C1" s="1" t="inlineStr"><is><t>Du'a / Quran</t></is></c><c r="D1" s="1" t="inlineStr"><is><t>Dhikr (Arabic)</t></is></c><c r="E1" s="1" t="inlineStr"><is><t>Dhikr in the Hadith (context)</t></is></c><c r="F1" s="1" t="inlineStr"><is><t>Dhikr Meaning (English)</t></is></c><c r="G1" s="1" t="inlineStr"><is><t>Hadith Meaning (English)</t></is></c><c r="H1" s="1" t="inlineStr"><is><t>Time of Day</t></is></c><c r="I1" s="1" t="inlineStr"><is><t>Times to Repeat</t></is></c><c r="J1" s="1" t="inlineStr"><is><t>Source</t></is></c><c r="K1" s="1" t="inlineStr"><is><t>Grade</t></is></c><c r="L1" s="1" t="inlineStr"><is><t>Link</t></is></c></row><row r="2"><c r="A2" s="2" t="n"><v>1</v></c><c r="B2" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C2" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D2" s="3" t="inlineStr"><is><t>&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1571;&#1614;&#1606;&#1618;&#1578;&#1614; &#1585;&#1614;&#1576;&#1616;&#1617;&#1610; &#1604;&#1614;&#1575; &#1573;&#1616;&#1604;&#1614;&#1607;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1571;&#1614;&#1606;&#1618;&#1578;&#1614;&#1548; &#1582;&#1614;&#1604;&#1614;&#1602;&#1618;&#1578;&#1614;&#1606;&#1616;&#1610; &#1608;&#1614;&#1571;&#1614;&#1606;&#1614;&#1575; &#1593;&#1614;&#1576;&#1618;&#1583;&#1615;&#1603;&#1614;&#1548; &#1608;&#1614;&#1571;&#1614;&#1606;&#1614;&#1575; &#1593;&#1614;&#1604;&#1614;&#1609; &#1593;&#1614;&#1607;&#1618;&#1583;&#1616;&#1603;&#1614; &#1608;&#1614;&#1608;&#1614;&#1593;&#1618;&#1583;&#1616;&#1603;&#1614; &#1605;&#1614;&#1575; &#1575;&#1587;&#1618;&#1578;&#1614;&#1591;&#1614;&#1593;&#1618;&#1578;&#1615;&#1548; &#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1603;&#1614; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1605;&#1614;&#1575; &#1589;&#1614;&#1606;&#1614;&#1593;&#1618;&#1578;&#1615;&#1548; &#1571;&#1614;&#1576;&#1615;&#1608;&#1569;&#1615; &#1604;&#1614;&#1603;&#1614; &#1576;&#1616;&#1606;&#1616;&#1593;&#1618;&#1605;&#1614;&#1578;&#1616;&#1603;&#1614; &#1593;&#1614;&#1604;&#1614;&#1610;&#1614;&#1617;&#1548; &#1608;&#1614;&#1571;&#1614;&#1576;&#1615;&#1608;&#1569;&#1615; &#1576;&#1616;&#1584;&#1614;&#1606;&#1618;&#1576;&#1616;&#1610; &#1601;&#1614;&#1575;&#1594;&#1618;&#1601;&#1616;&#1585;&#1618; &#1604;&#1616;&#1610; &#1601;&#1614;&#1573;&#1616;&#1606;&#1614;&#1617;&#1607;&#1615; &#1604;&#1614;&#1575; &#1610;&#1614;&#1594;&#1618;&#1601;&#1616;&#1585;&#1615; &#1575;&#1604;&#1584;&#1615;&#1617;&#1606;&#1615;&#1608;&#1576;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1571;&#1614;&#1606;&#1618;&#1578;&#1614;</t></is></c><c r="E2" s="4" t="inlineStr"><is><t>Narrated by Shaddad ibn Aws: the Prophet (SAW) taught that the best way of asking forgiveness is this du'a, and added that whoever says it in the day with firm conviction and dies before evening, or says it at night with conviction and dies before morning, will be among the people of Paradise.</t></is></c><c r="F2" s="4" t="inlineStr"><is><t>O Allah, You are my Lord, none has the right to be worshipped but You. You created me and I am Your servant; I keep Your covenant and promise as best I can. I seek refuge in You from the evil I have done. I acknowledge Your favour upon me and I confess my sin, so forgive me, for none forgives sins but You.</t></is></c><c r="G2" s="4" t="inlineStr"><is><t>The most superior way of seeking Allah's forgiveness; a guarantee of Paradise for the one who says it with certainty and dies that day/night.</t></is></c><c r="H2" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I2" s="2" t="inlineStr"><is><t>1</t></is></c><c r="J2" s="4" t="inlineStr"><is><t>Sahih al-Bukhari 6306</t></is></c><c r="K2" s="2" t="inlineStr"><is><t>Sahih</t></is></c><c r="L2" s="5" t="inlineStr"><is><t>https://sunnah.com/bukhari:6306</t></is></c></row><row r="3"><c r="A3" s="6" t="n"><v>2</v></c><c r="B3" s="6" t="inlineStr"><is><t>Dhikr</t></is></c><c r="C3" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D3" s="7" t="inlineStr"><is><t>&#1604;&#1614;&#1575; &#1573;&#1616;&#1604;&#1614;&#1607;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1608;&#1614;&#1581;&#1618;&#1583;&#1614;&#1607;&#1615; &#1604;&#1614;&#1575; &#1588;&#1614;&#1585;&#1616;&#1610;&#1603;&#1614; &#1604;&#1614;&#1607;&#1615;&#1548; &#1604;&#1614;&#1607;&#1615; &#1575;&#1604;&#1618;&#1605;&#1615;&#1604;&#1618;&#1603;&#1615; &#1608;&#1614;&#1604;&#1614;&#1607;&#1615; &#1575;&#1604;&#1618;&#1581;&#1614;&#1605;&#1618;&#1583;&#1615;&#1548; &#1608;&#1614;&#1607;&#1615;&#1608;&#1614; &#1593;&#1614;&#1604;&#1614;&#1609; &#1603;&#1615;&#1604;&#1616;&#1617; &#1588;&#1614;&#1610;&#1618;&#1569;&#1613; &#1602;&#1614;&#1583;&#1616;&#1610;&#1585;&#1612;</t></is></c><c r="E3" s="8" t="inlineStr"><is><t>Narrated by Abu Hurairah: the Prophet (SAW) said whoever says this 100 times a day earns the reward of freeing ten slaves, has 100 good deeds recorded and 100 sins erased, and is protected from Shaytan that day until evening; none does better except one who says it more.</t></is></c><c r="F3" s="8" t="inlineStr"><is><t>None has the right to be worshipped but Allah alone, with no partner. His is the dominion and His is the praise, and He is over all things competent.</t></is></c><c r="G3" s="8" t="inlineStr"><is><t>Reward equal to freeing ten slaves, 100 good deeds, 100 sins erased, and protection from Shaytan for the day.</t></is></c><c r="H3" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I3" s="6" t="inlineStr"><is><t>10 (also 100 anytime)</t></is></c><c r="J3" s="8" t="inlineStr"><is><t>Sahih al-Bukhari 6403 (also 3293); Sahih Muslim 2691</t></is></c><c r="K3" s="6" t="inlineStr"><is><t>Sahih</t></is></c><c r="L3" s="9" t="inlineStr"><is><t>https://sunnah.com/bukhari:6403</t></is></c></row><row r="4"><c r="A4" s="2" t="n"><v>3</v></c><c r="B4" s="2" t="inlineStr"><is><t>Dhikr</t></is></c><c r="C4" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D4" s="3" t="inlineStr"><is><t>&#1587;&#1615;&#1576;&#1618;&#1581;&#1614;&#1575;&#1606;&#1614; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1616; &#1608;&#1614;&#1576;&#1616;&#1581;&#1614;&#1605;&#1618;&#1583;&#1616;&#1607;&#1616;</t></is></c><c r="E4" s="4" t="inlineStr"><is><t>Narrated by Abu Hurairah: the Prophet (SAW) said whoever says this 100 times a day will have his sins wiped away even if they were like the foam of the sea.</t></is></c><c r="F4" s="4" t="inlineStr"><is><t>Glory is to Allah and praise is to Him.</t></is></c><c r="G4" s="4" t="inlineStr"><is><t>Sins forgiven even if they were as much as the foam of the sea.</t></is></c><c r="H4" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I4" s="2" t="inlineStr"><is><t>100</t></is></c><c r="J4" s="4" t="inlineStr"><is><t>Sahih al-Bukhari 6405; Sahih Muslim 2691</t></is></c><c r="K4" s="2" t="inlineStr"><is><t>Sahih</t></is></c><c r="L4" s="5" t="inlineStr"><is><t>https://sunnah.com/bukhari:6405</t></is></c></row><row r="5"><c r="A5" s="6" t="n"><v>4</v></c><c r="B5" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C5" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D5" s="7" t="inlineStr"><is><t>&#1576;&#1616;&#1587;&#1618;&#1605;&#1616; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1616; &#1575;&#1604;&#1614;&#1617;&#1584;&#1616;&#1610; &#1604;&#1614;&#1575; &#1610;&#1614;&#1590;&#1615;&#1585;&#1615;&#1617; &#1605;&#1614;&#1593;&#1614; &#1575;&#1587;&#1618;&#1605;&#1616;&#1607;&#1616; &#1588;&#1614;&#1610;&#1618;&#1569;&#1612; &#1601;&#1616;&#1610; &#1575;&#1604;&#1618;&#1571;&#1614;&#1585;&#1618;&#1590;&#1616; &#1608;&#1614;&#1604;&#1614;&#1575; &#1601;&#1616;&#1610; &#1575;&#1604;&#1587;&#1614;&#1617;&#1605;&#1614;&#1575;&#1569;&#1616; &#1608;&#1614;&#1607;&#1615;&#1608;&#1614; &#1575;&#1604;&#1587;&#1614;&#1617;&#1605;&#1616;&#1610;&#1593;&#1615; &#1575;&#1604;&#1618;&#1593;&#1614;&#1604;&#1616;&#1610;&#1605;&#1615;</t></is></c><c r="E5" s="8" t="inlineStr"><is><t>Narrated from Uthman ibn Affan: the Prophet (SAW) said there is no servant who says this three times every morning and every evening but that nothing will harm him.</t></is></c><c r="F5" s="8" t="inlineStr"><is><t>In the Name of Allah, with whose Name nothing on earth or in heaven can cause harm, and He is the All-Hearing, the All-Knowing.</t></is></c><c r="G5" s="8" t="inlineStr"><is><t>Protection so that nothing will harm the one who recites it three times, morning and evening.</t></is></c><c r="H5" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I5" s="6" t="inlineStr"><is><t>3</t></is></c><c r="J5" s="8" t="inlineStr"><is><t>Sunan al-Tirmidhi 3388 (also Abu Dawud 5088; Ibn Majah 3869)</t></is></c><c r="K5" s="6" t="inlineStr"><is><t>Hasan Sahih</t></is></c><c r="L5" s="9" t="inlineStr"><is><t>https://sunnah.com/tirmidhi:3388</t></is></c></row><row r="6"><c r="A6" s="2" t="n"><v>5</v></c><c r="B6" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C6" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D6" s="3" t="inlineStr"><is><t>&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1573;&#1616;&#1606;&#1616;&#1617;&#1610; &#1571;&#1614;&#1587;&#1618;&#1571;&#1614;&#1604;&#1615;&#1603;&#1614; &#1575;&#1604;&#1618;&#1593;&#1614;&#1601;&#1618;&#1608;&#1614; &#1608;&#1614;&#1575;&#1604;&#1618;&#1593;&#1614;&#1575;&#1601;&#1616;&#1610;&#1614;&#1577;&#1614; &#1601;&#1616;&#1610; &#1575;&#1604;&#1583;&#1615;&#1617;&#1606;&#1618;&#1610;&#1614;&#1575; &#1608;&#1614;&#1575;&#1604;&#1618;&#1570;&#1582;&#1616;&#1585;&#1614;&#1577;&#1616;&#1548; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1573;&#1616;&#1606;&#1616;&#1617;&#1610; &#1571;&#1614;&#1587;&#1618;&#1571;&#1614;&#1604;&#1615;&#1603;&#1614; &#1575;&#1604;&#1618;&#1593;&#1614;&#1601;&#1618;&#1608;&#1614; &#1608;&#1614;&#1575;&#1604;&#1618;&#1593;&#1614;&#1575;&#1601;&#1616;&#1610;&#1614;&#1577;&#1614; &#1601;&#1616;&#1610; &#1583;&#1616;&#1610;&#1606;&#1616;&#1610; &#1608;&#1614;&#1583;&#1615;&#1606;&#1618;&#1610;&#1614;&#1575;&#1610;&#1614; &#1608;&#1614;&#1571;&#1614;&#1607;&#1618;&#1604;&#1616;&#1610; &#1608;&#1614;&#1605;&#1614;&#1575;&#1604;&#1616;&#1610;&#1548; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1575;&#1587;&#1618;&#1578;&#1615;&#1585;&#1618; &#1593;&#1614;&#1608;&#1618;&#1585;&#1614;&#1575;&#1578;&#1616;&#1610; &#1608;&#1614;&#1570;&#1605;&#1616;&#1606;&#1618; &#1585;&#1614;&#1608;&#1618;&#1593;&#1614;&#1575;&#1578;&#1616;&#1610;&#1548; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1575;&#1581;&#1618;&#1601;&#1614;&#1592;&#1618;&#1606;&#1616;&#1610; &#1605;&#1616;&#1606;&#1618; &#1576;&#1614;&#1610;&#1618;&#1606;&#1616; &#1610;&#1614;&#1583;&#1614;&#1610;&#1614;&#1617; &#1608;&#1614;&#1605;&#1616;&#1606;&#1618; &#1582;&#1614;&#1604;&#1618;&#1601;&#1616;&#1610; &#1608;&#1614;&#1593;&#1614;&#1606;&#1618; &#1610;&#1614;&#1605;&#1616;&#1610;&#1606;&#1616;&#1610; &#1608;&#1614;&#1593;&#1614;&#1606;&#1618; &#1588;&#1616;&#1605;&#1614;&#1575;&#1604;&#1616;&#1610; &#1608;&#1614;&#1605;&#1616;&#1606;&#1618; &#1601;&#1614;&#1608;&#1618;&#1602;&#1616;&#1610; &#1608;&#1614;&#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1593;&#1614;&#1592;&#1614;&#1605;&#1614;&#1578;&#1616;&#1603;&#1614; &#1571;&#1614;&#1606;&#1618; &#1571;&#1615;&#1594;&#1618;&#1578;&#1614;&#1575;&#1604;&#1614; &#1605;&#1616;&#1606;&#1618; &#1578;&#1614;&#1581;&#1618;&#1578;&#1616;&#1610;</t></is></c><c r="E6" s="4" t="inlineStr"><is><t>Narrated by Ibn Umar: the Prophet (SAW) never abandoned these supplications in the morning and evening.</t></is></c><c r="F6" s="4" t="inlineStr"><is><t>O Allah, I ask You for pardon and well-being in this world and the Hereafter. O Allah, I ask You for pardon and well-being in my religion, my worldly affairs, my family and my wealth. O Allah, conceal my faults and calm my fears. O Allah, guard me from before me, behind me, my right, my left and above me, and I seek refuge in Your greatness from being struck down from beneath me.</t></is></c><c r="G6" s="4" t="inlineStr"><is><t>A comprehensive request for pardon, protection and safety from every direction; a du'a the Prophet (SAW) never left.</t></is></c><c r="H6" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I6" s="2" t="inlineStr"><is><t>1</t></is></c><c r="J6" s="4" t="inlineStr"><is><t>Sunan Abi Dawud 5074 (also Ibn Majah 3871)</t></is></c><c r="K6" s="2" t="inlineStr"><is><t>Sahih (al-Albani)</t></is></c><c r="L6" s="5" t="inlineStr"><is><t>https://sunnah.com/abudawud:5074</t></is></c></row><row r="7"><c r="A7" s="6" t="n"><v>6</v></c><c r="B7" s="6" t="inlineStr"><is><t>Surah</t></is></c><c r="C7" s="6" t="inlineStr"><is><t>Quran</t></is></c><c r="D7" s="7" t="inlineStr"><is><t>&#1602;&#1615;&#1604;&#1618; &#1607;&#1615;&#1608;&#1614; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1571;&#1614;&#1581;&#1614;&#1583;&#1612; &#1757; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1575;&#1604;&#1589;&#1614;&#1617;&#1605;&#1614;&#1583;&#1615; &#1757; &#1604;&#1614;&#1605;&#1618; &#1610;&#1614;&#1604;&#1616;&#1583;&#1618; &#1608;&#1614;&#1604;&#1614;&#1605;&#1618; &#1610;&#1615;&#1608;&#1604;&#1614;&#1583;&#1618; &#1757; &#1608;&#1614;&#1604;&#1614;&#1605;&#1618; &#1610;&#1614;&#1603;&#1615;&#1606;&#1618; &#1604;&#1614;&#1607;&#1615; &#1603;&#1615;&#1601;&#1615;&#1608;&#1611;&#1575; &#1571;&#1614;&#1581;&#1614;&#1583;&#1612;</t></is></c><c r="E7" s="8" t="inlineStr"><is><t>Narrated by Abdullah ibn Khubayb: the Prophet (SAW) said to recite Surah Al-Ikhlas and the Mu'awwidhatayn (Al-Falaq and An-Naas) three times in the morning and evening; they will suffice him against everything.</t></is></c><c r="F7" s="8" t="inlineStr"><is><t>Say: He is Allah, One. Allah, the Eternal Refuge. He neither begets nor is born, and there is none comparable to Him. (Surah 112)</t></is></c><c r="G7" s="8" t="inlineStr"><is><t>Reciting the three Quls three times morning and evening suffices the believer as protection against all things.</t></is></c><c r="H7" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I7" s="6" t="inlineStr"><is><t>3</t></is></c><c r="J7" s="8" t="inlineStr"><is><t>Sunan Abi Dawud 5082; Sunan al-Tirmidhi 3575</t></is></c><c r="K7" s="6" t="inlineStr"><is><t>Hasan Sahih</t></is></c><c r="L7" s="9" t="inlineStr"><is><t>https://sunnah.com/abudawud:5082</t></is></c></row><row r="8"><c r="A8" s="2" t="n"><v>7</v></c><c r="B8" s="2" t="inlineStr"><is><t>Surah</t></is></c><c r="C8" s="2" t="inlineStr"><is><t>Quran</t></is></c><c r="D8" s="3" t="inlineStr"><is><t>&#1602;&#1615;&#1604;&#1618; &#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1585;&#1614;&#1576;&#1616;&#1617; &#1575;&#1604;&#1618;&#1601;&#1614;&#1604;&#1614;&#1602;&#1616; &#1757; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1605;&#1614;&#1575; &#1582;&#1614;&#1604;&#1614;&#1602;&#1614; &#1757; &#1608;&#1614;&#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1594;&#1614;&#1575;&#1587;&#1616;&#1602;&#1613; &#1573;&#1616;&#1584;&#1614;&#1575; &#1608;&#1614;&#1602;&#1614;&#1576;&#1614; &#1757; &#1608;&#1614;&#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1575;&#1604;&#1606;&#1614;&#1617;&#1601;&#1614;&#1617;&#1575;&#1579;&#1614;&#1575;&#1578;&#1616; &#1601;&#1616;&#1610; &#1575;&#1604;&#1618;&#1593;&#1615;&#1602;&#1614;&#1583;&#1616; &#1757; &#1608;&#1614;&#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1581;&#1614;&#1575;&#1587;&#1616;&#1583;&#1613; &#1573;&#1616;&#1584;&#1614;&#1575; &#1581;&#1614;&#1587;&#1614;&#1583;&#1614;</t></is></c><c r="E8" s="4" t="inlineStr"><is><t>Narrated by Abdullah ibn Khubayb: part of the three Quls the Prophet (SAW) instructed to recite three times morning and evening as sufficient protection.</t></is></c><c r="F8" s="4" t="inlineStr"><is><t>Say: I seek refuge in the Lord of the daybreak, from the evil of what He created, from the evil of darkness when it settles, from the evil of those who blow on knots, and from the evil of an envier when he envies. (Surah 113)</t></is></c><c r="G8" s="4" t="inlineStr"><is><t>Protection against all created evil, darkness, sorcery and envy.</t></is></c><c r="H8" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I8" s="2" t="inlineStr"><is><t>3</t></is></c><c r="J8" s="4" t="inlineStr"><is><t>Sunan Abi Dawud 5082; Sunan al-Tirmidhi 3575</t></is></c><c r="K8" s="2" t="inlineStr"><is><t>Hasan Sahih</t></is></c><c r="L8" s="5" t="inlineStr"><is><t>https://sunnah.com/abudawud:5082</t></is></c></row><row r="9"><c r="A9" s="6" t="n"><v>8</v></c><c r="B9" s="6" t="inlineStr"><is><t>Surah</t></is></c><c r="C9" s="6" t="inlineStr"><is><t>Quran</t></is></c><c r="D9" s="7" t="inlineStr"><is><t>&#1602;&#1615;&#1604;&#1618; &#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1585;&#1614;&#1576;&#1616;&#1617; &#1575;&#1604;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616; &#1757; &#1605;&#1614;&#1604;&#1616;&#1603;&#1616; &#1575;&#1604;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616; &#1757; &#1573;&#1616;&#1604;&#1614;&#1607;&#1616; &#1575;&#1604;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616; &#1757; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1575;&#1604;&#1618;&#1608;&#1614;&#1587;&#1618;&#1608;&#1614;&#1575;&#1587;&#1616; &#1575;&#1604;&#1618;&#1582;&#1614;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616; &#1757; &#1575;&#1604;&#1614;&#1617;&#1584;&#1616;&#1610; &#1610;&#1615;&#1608;&#1614;&#1587;&#1618;&#1608;&#1616;&#1587;&#1615; &#1601;&#1616;&#1610; &#1589;&#1615;&#1583;&#1615;&#1608;&#1585;&#1616; &#1575;&#1604;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616; &#1757; &#1605;&#1616;&#1606;&#1614; &#1575;&#1604;&#1618;&#1580;&#1616;&#1606;&#1614;&#1617;&#1577;&#1616; &#1608;&#1614;&#1575;&#1604;&#1606;&#1614;&#1617;&#1575;&#1587;&#1616;</t></is></c><c r="E9" s="8" t="inlineStr"><is><t>Narrated by Abdullah ibn Khubayb: part of the three Quls the Prophet (SAW) instructed to recite three times morning and evening as sufficient protection.</t></is></c><c r="F9" s="8" t="inlineStr"><is><t>Say: I seek refuge in the Lord of humankind, the Sovereign of humankind, the God of humankind, from the evil of the retreating whisperer who whispers in the breasts of humankind, from among jinn and humankind. (Surah 114)</t></is></c><c r="G9" s="8" t="inlineStr"><is><t>Protection from the whispers of Shaytan among jinn and mankind.</t></is></c><c r="H9" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I9" s="6" t="inlineStr"><is><t>3</t></is></c><c r="J9" s="8" t="inlineStr"><is><t>Sunan Abi Dawud 5082; Sunan al-Tirmidhi 3575</t></is></c><c r="K9" s="6" t="inlineStr"><is><t>Hasan Sahih</t></is></c><c r="L9" s="9" t="inlineStr"><is><t>https://sunnah.com/abudawud:5082</t></is></c></row><row r="10"><c r="A10" s="2" t="n"><v>9</v></c><c r="B10" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C10" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D10" s="3" t="inlineStr"><is><t>&#1585;&#1614;&#1590;&#1616;&#1610;&#1578;&#1615; &#1576;&#1616;&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1616; &#1585;&#1614;&#1576;&#1611;&#1617;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1575;&#1604;&#1618;&#1573;&#1616;&#1587;&#1618;&#1604;&#1614;&#1575;&#1605;&#1616; &#1583;&#1616;&#1610;&#1606;&#1611;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1605;&#1615;&#1581;&#1614;&#1605;&#1614;&#1617;&#1583;&#1613; &#1589;&#1614;&#1604;&#1614;&#1617;&#1609; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1593;&#1614;&#1604;&#1614;&#1610;&#1618;&#1607;&#1616; &#1608;&#1614;&#1587;&#1614;&#1604;&#1614;&#1617;&#1605;&#1614; &#1606;&#1614;&#1576;&#1616;&#1610;&#1611;&#1617;&#1575;</t></is></c><c r="E10" s="4" t="inlineStr"><is><t>Narrated from Thawban / Abu Salam: the Prophet (SAW) said whoever says this upon entering the morning and evening, it is a right upon Allah to please him on the Day of Resurrection.</t></is></c><c r="F10" s="4" t="inlineStr"><is><t>I am pleased with Allah as my Lord, with Islam as my religion, and with Muhammad (SAW) as my Prophet.</t></is></c><c r="G10" s="4" t="inlineStr"><is><t>Allah takes it upon Himself to please this person on the Day of Resurrection.</t></is></c><c r="H10" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I10" s="2" t="inlineStr"><is><t>3</t></is></c><c r="J10" s="4" t="inlineStr"><is><t>Musnad Ahmad 18968 (book's ref); Sunan al-Tirmidhi 3389; Ibn Majah 3870</t></is></c><c r="K10" s="2" t="inlineStr"><is><t>Hasan</t></is></c><c r="L10" s="5" t="inlineStr"><is><t>https://sunnah.com/tirmidhi:3389</t></is></c></row><row r="11"><c r="A11" s="6" t="n"><v>10</v></c><c r="B11" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C11" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D11" s="7" t="inlineStr"><is><t>&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1601;&#1614;&#1575;&#1591;&#1616;&#1585;&#1614; &#1575;&#1604;&#1587;&#1614;&#1617;&#1605;&#1614;&#1575;&#1608;&#1614;&#1575;&#1578;&#1616; &#1608;&#1614;&#1575;&#1604;&#1618;&#1571;&#1614;&#1585;&#1618;&#1590;&#1616;&#1548; &#1593;&#1614;&#1575;&#1604;&#1616;&#1605;&#1614; &#1575;&#1604;&#1618;&#1594;&#1614;&#1610;&#1618;&#1576;&#1616; &#1608;&#1614;&#1575;&#1604;&#1588;&#1614;&#1617;&#1607;&#1614;&#1575;&#1583;&#1614;&#1577;&#1616;&#1548; &#1585;&#1614;&#1576;&#1614;&#1617; &#1603;&#1615;&#1604;&#1616;&#1617; &#1588;&#1614;&#1610;&#1618;&#1569;&#1613; &#1608;&#1614;&#1605;&#1614;&#1604;&#1616;&#1610;&#1603;&#1614;&#1607;&#1615;&#1548; &#1571;&#1614;&#1588;&#1618;&#1607;&#1614;&#1583;&#1615; &#1571;&#1614;&#1606;&#1618; &#1604;&#1614;&#1575; &#1573;&#1616;&#1604;&#1614;&#1607;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1571;&#1614;&#1606;&#1618;&#1578;&#1614;&#1548; &#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1603;&#1614; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1606;&#1614;&#1601;&#1618;&#1587;&#1616;&#1610; &#1608;&#1614;&#1588;&#1614;&#1585;&#1616;&#1617; &#1575;&#1604;&#1588;&#1614;&#1617;&#1610;&#1618;&#1591;&#1614;&#1575;&#1606;&#1616; &#1608;&#1614;&#1588;&#1616;&#1585;&#1618;&#1603;&#1616;&#1607;&#1616;&#1548; &#1608;&#1614;&#1571;&#1614;&#1606;&#1618; &#1571;&#1614;&#1602;&#1618;&#1578;&#1614;&#1585;&#1616;&#1601;&#1614; &#1593;&#1614;&#1604;&#1614;&#1609; &#1606;&#1614;&#1601;&#1618;&#1587;&#1616;&#1610; &#1587;&#1615;&#1608;&#1569;&#1611;&#1575; &#1571;&#1614;&#1608;&#1618; &#1571;&#1614;&#1580;&#1615;&#1585;&#1614;&#1617;&#1607;&#1615; &#1573;&#1616;&#1604;&#1614;&#1609; &#1605;&#1615;&#1587;&#1618;&#1604;&#1616;&#1605;&#1613;</t></is></c><c r="E11" s="8" t="inlineStr"><is><t>Narrated by Abu Bakr As-Siddiq: the Prophet (SAW) taught him to say this in the morning, evening and when going to bed.</t></is></c><c r="F11" s="8" t="inlineStr"><is><t>O Allah, Creator of the heavens and the earth, Knower of the seen and unseen, Lord and Sovereign of all things: I testify that none is worthy of worship but You. I seek refuge in You from the evil of my soul, the evil of Shaytan and his shirk, and from bringing evil upon myself or dragging it to any Muslim.</t></is></c><c r="G11" s="8" t="inlineStr"><is><t>Refuge from the evil of one's own soul, from Shaytan, and from harming oneself or any Muslim.</t></is></c><c r="H11" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I11" s="6" t="inlineStr"><is><t>1</t></is></c><c r="J11" s="8" t="inlineStr"><is><t>Sunan Abi Dawud 5067; addition in al-Tirmidhi 3529</t></is></c><c r="K11" s="6" t="inlineStr"><is><t>Sahih (al-Albani)</t></is></c><c r="L11" s="9" t="inlineStr"><is><t>https://sunnah.com/abudawud:5067</t></is></c></row><row r="12"><c r="A12" s="2" t="n"><v>11</v></c><c r="B12" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C12" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D12" s="3" t="inlineStr"><is><t>&#1610;&#1614;&#1575; &#1581;&#1614;&#1610;&#1615;&#1617; &#1610;&#1614;&#1575; &#1602;&#1614;&#1610;&#1615;&#1617;&#1608;&#1605;&#1615; &#1576;&#1616;&#1585;&#1614;&#1581;&#1618;&#1605;&#1614;&#1578;&#1616;&#1603;&#1614; &#1571;&#1614;&#1587;&#1618;&#1578;&#1614;&#1594;&#1616;&#1610;&#1579;&#1615;&#1548; &#1571;&#1614;&#1589;&#1618;&#1604;&#1616;&#1581;&#1618; &#1604;&#1616;&#1610; &#1588;&#1614;&#1571;&#1618;&#1606;&#1616;&#1610; &#1603;&#1615;&#1604;&#1614;&#1617;&#1607;&#1615; &#1608;&#1614;&#1604;&#1614;&#1575; &#1578;&#1614;&#1603;&#1616;&#1604;&#1618;&#1606;&#1616;&#1610; &#1573;&#1616;&#1604;&#1614;&#1609; &#1606;&#1614;&#1601;&#1618;&#1587;&#1616;&#1610; &#1591;&#1614;&#1585;&#1618;&#1601;&#1614;&#1577;&#1614; &#1593;&#1614;&#1610;&#1618;&#1606;&#1613;</t></is></c><c r="E12" s="4" t="inlineStr"><is><t>Narrated by Anas ibn Malik: the Prophet (SAW) told Fatimah (RA) to say this every morning and evening, asking what prevents her from this advice.</t></is></c><c r="F12" s="4" t="inlineStr"><is><t>O Ever-Living, O Sustainer, by Your mercy I seek relief. Rectify all my affairs and do not leave me to myself for the blink of an eye.</t></is></c><c r="G12" s="4" t="inlineStr"><is><t>Reliance on Allah to set right all affairs and never be left to one's own self.</t></is></c><c r="H12" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I12" s="2" t="inlineStr"><is><t>1</t></is></c><c r="J12" s="4" t="inlineStr"><is><t>Sunan an-Nasa'i al-Kubra 10405 (book's ref); Hisn al-Muslim 88</t></is></c><c r="K12" s="2" t="inlineStr"><is><t>Hasan / Sahih (al-Mundhiri, al-Albani)</t></is></c><c r="L12" s="5" t="inlineStr"><is><t>https://sunnah.com/hisn:88</t></is></c></row><row r="13"><c r="A13" s="6" t="n"><v>12</v></c><c r="B13" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C13" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D13" s="7" t="inlineStr"><is><t>&#1571;&#1614;&#1589;&#1618;&#1576;&#1614;&#1581;&#1618;&#1606;&#1614;&#1575; &#1608;&#1614;&#1571;&#1614;&#1589;&#1618;&#1576;&#1614;&#1581;&#1614; &#1575;&#1604;&#1618;&#1605;&#1615;&#1604;&#1618;&#1603;&#1615; &#1604;&#1616;&#1604;&#1614;&#1617;&#1607;&#1616;&#1548; &#1608;&#1614;&#1575;&#1604;&#1618;&#1581;&#1614;&#1605;&#1618;&#1583;&#1615; &#1604;&#1616;&#1604;&#1614;&#1617;&#1607;&#1616;&#1548; &#1604;&#1614;&#1575; &#1573;&#1616;&#1604;&#1614;&#1607;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1608;&#1614;&#1581;&#1618;&#1583;&#1614;&#1607;&#1615; &#1604;&#1614;&#1575; &#1588;&#1614;&#1585;&#1616;&#1610;&#1603;&#1614; &#1604;&#1614;&#1607;&#1615;... &#1585;&#1614;&#1576;&#1616;&#1617; &#1571;&#1614;&#1587;&#1618;&#1571;&#1614;&#1604;&#1615;&#1603;&#1614; &#1582;&#1614;&#1610;&#1618;&#1585;&#1614; &#1605;&#1614;&#1575; &#1601;&#1616;&#1610; &#1607;&#1614;&#1584;&#1614;&#1575; &#1575;&#1604;&#1618;&#1610;&#1614;&#1608;&#1618;&#1605;&#1616; &#1608;&#1614;&#1582;&#1614;&#1610;&#1618;&#1585;&#1614; &#1605;&#1614;&#1575; &#1576;&#1614;&#1593;&#1618;&#1583;&#1614;&#1607;&#1615;&#1548; &#1608;&#1614;&#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1603;&#1614; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1605;&#1614;&#1575; &#1601;&#1616;&#1610; &#1607;&#1614;&#1584;&#1614;&#1575; &#1575;&#1604;&#1618;&#1610;&#1614;&#1608;&#1618;&#1605;&#1616; &#1608;&#1614;&#1588;&#1614;&#1585;&#1616;&#1617; &#1605;&#1614;&#1575; &#1576;&#1614;&#1593;&#1618;&#1583;&#1614;&#1607;&#1615;... (evening: &#1571;&#1614;&#1605;&#1618;&#1587;&#1614;&#1610;&#1618;&#1606;&#1614;&#1575; &#1608;&#1614;&#1571;&#1614;&#1605;&#1618;&#1587;&#1614;&#1609; &#1575;&#1604;&#1618;&#1605;&#1615;&#1604;&#1618;&#1603;&#1615; &#1604;&#1616;&#1604;&#1614;&#1617;&#1607;&#1616;...)</t></is></c><c r="E13" s="8" t="inlineStr"><is><t>Narrated by Ibn Mas'ud / Abdullah ibn Khubayb: the Prophet (SAW) used to say this upon entering the morning, and the corresponding wording (Amsayna...) in the evening.</t></is></c><c r="F13" s="8" t="inlineStr"><is><t>We have entered the morning and dominion belongs to Allah; praise be to Allah; none is worthy of worship but Allah alone, no partner. My Lord, I ask You for the good of this day and the good after it, and I seek refuge from the evil of this day and after it; from laziness, the misery of old age, the punishment of the Fire and the punishment of the grave.</t></is></c><c r="G13" s="8" t="inlineStr"><is><t>Asking Allah for the good of the day/night and refuge from its evils, laziness, old age, Hellfire and the grave.</t></is></c><c r="H13" s="6" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I13" s="6" t="inlineStr"><is><t>1</t></is></c><c r="J13" s="8" t="inlineStr"><is><t>Sahih Muslim 2723 (also Hisn al-Muslim 77)</t></is></c><c r="K13" s="6" t="inlineStr"><is><t>Sahih</t></is></c><c r="L13" s="9" t="inlineStr"><is><t>https://sunnah.com/muslim:2723</t></is></c></row><row r="14"><c r="A14" s="2" t="n"><v>13</v></c><c r="B14" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C14" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D14" s="3" t="inlineStr"><is><t>&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1576;&#1616;&#1603;&#1614; &#1571;&#1614;&#1589;&#1618;&#1576;&#1614;&#1581;&#1618;&#1606;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1571;&#1614;&#1605;&#1618;&#1587;&#1614;&#1610;&#1618;&#1606;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1606;&#1614;&#1581;&#1618;&#1610;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1606;&#1614;&#1605;&#1615;&#1608;&#1578;&#1615;&#1548; &#1608;&#1614;&#1573;&#1616;&#1604;&#1614;&#1610;&#1618;&#1603;&#1614; &#1575;&#1604;&#1606;&#1615;&#1617;&#1588;&#1615;&#1608;&#1585;&#1615;</t></is></c><c r="E14" s="4" t="inlineStr"><is><t>Narrated by Abu Hurairah: the Prophet (SAW) taught this to be said upon entering the morning.</t></is></c><c r="F14" s="4" t="inlineStr"><is><t>O Allah, by You we enter the morning, by You we enter the evening, by You we live, by You we die, and to You is the resurrection.</t></is></c><c r="G14" s="4" t="inlineStr"><is><t>Acknowledging that life, death and the return are all by and to Allah.</t></is></c><c r="H14" s="2" t="inlineStr"><is><t>Morning</t></is></c><c r="I14" s="2" t="inlineStr"><is><t>1</t></is></c><c r="J14" s="4" t="inlineStr"><is><t>Sunan Abi Dawud 5068</t></is></c><c r="K14" s="2" t="inlineStr"><is><t>Sahih (al-Albani)</t></is></c><c r="L14" s="5" t="inlineStr"><is><t>https://sunnah.com/abudawud:5068</t></is></c></row><row r="15"><c r="A15" s="6" t="n"><v>14</v></c><c r="B15" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C15" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D15" s="7" t="inlineStr"><is><t>&#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615;&#1605;&#1614;&#1617; &#1576;&#1616;&#1603;&#1614; &#1571;&#1614;&#1605;&#1618;&#1587;&#1614;&#1610;&#1618;&#1606;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1571;&#1614;&#1589;&#1618;&#1576;&#1614;&#1581;&#1618;&#1606;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1606;&#1614;&#1581;&#1618;&#1610;&#1614;&#1575;&#1548; &#1608;&#1614;&#1576;&#1616;&#1603;&#1614; &#1606;&#1614;&#1605;&#1615;&#1608;&#1578;&#1615;&#1548; &#1608;&#1614;&#1573;&#1616;&#1604;&#1614;&#1610;&#1618;&#1603;&#1614; &#1575;&#1604;&#1618;&#1605;&#1614;&#1589;&#1616;&#1610;&#1585;&#1615;</t></is></c><c r="E15" s="8" t="inlineStr"><is><t>Narrated by Abu Hurairah: the corresponding evening wording of the previous supplication.</t></is></c><c r="F15" s="8" t="inlineStr"><is><t>O Allah, by You we enter the evening, by You we enter the morning, by You we live, by You we die, and to You is the final return.</t></is></c><c r="G15" s="8" t="inlineStr"><is><t>Evening form: life, death and the final return are all by and to Allah.</t></is></c><c r="H15" s="6" t="inlineStr"><is><t>Evening</t></is></c><c r="I15" s="6" t="inlineStr"><is><t>1</t></is></c><c r="J15" s="8" t="inlineStr"><is><t>Sunan Ibn Majah 3868</t></is></c><c r="K15" s="6" t="inlineStr"><is><t>Sahih (al-Albani)</t></is></c><c r="L15" s="9" t="inlineStr"><is><t>https://sunnah.com/ibnmajah:3868</t></is></c></row><row r="16"><c r="A16" s="2" t="n"><v>15</v></c><c r="B16" s="2" t="inlineStr"><is><t>Dhikr</t></is></c><c r="C16" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D16" s="3" t="inlineStr"><is><t>&#1587;&#1615;&#1576;&#1618;&#1581;&#1614;&#1575;&#1606;&#1614; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1616; &#1608;&#1614;&#1576;&#1616;&#1581;&#1614;&#1605;&#1618;&#1583;&#1616;&#1607;&#1616; &#1593;&#1614;&#1583;&#1614;&#1583;&#1614; &#1582;&#1614;&#1604;&#1618;&#1602;&#1616;&#1607;&#1616;&#1548; &#1608;&#1614;&#1585;&#1616;&#1590;&#1614;&#1575; &#1606;&#1614;&#1601;&#1618;&#1587;&#1616;&#1607;&#1616;&#1548; &#1608;&#1614;&#1586;&#1616;&#1606;&#1614;&#1577;&#1614; &#1593;&#1614;&#1585;&#1618;&#1588;&#1616;&#1607;&#1616;&#1548; &#1608;&#1614;&#1605;&#1616;&#1583;&#1614;&#1575;&#1583;&#1614; &#1603;&#1614;&#1604;&#1616;&#1605;&#1614;&#1575;&#1578;&#1616;&#1607;&#1616;</t></is></c><c r="E16" s="4" t="inlineStr"><is><t>Narrated by Juwayriyah (RA): the Prophet (SAW) said he had said these words three times and that they outweighed all she had recited since dawn.</t></is></c><c r="F16" s="4" t="inlineStr"><is><t>Glory and praise to Allah by the number of His creation, by His pleasure, by the weight of His Throne, and by the extent of His words.</t></is></c><c r="G16" s="4" t="inlineStr"><is><t>Words so weighty they outweigh a whole morning of other dhikr.</t></is></c><c r="H16" s="2" t="inlineStr"><is><t>Morning</t></is></c><c r="I16" s="2" t="inlineStr"><is><t>3</t></is></c><c r="J16" s="4" t="inlineStr"><is><t>Sahih Muslim 2726</t></is></c><c r="K16" s="2" t="inlineStr"><is><t>Sahih</t></is></c><c r="L16" s="5" t="inlineStr"><is><t>https://sunnah.com/muslim:2726</t></is></c></row><row r="17"><c r="A17" s="6" t="n"><v>16</v></c><c r="B17" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C17" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D17" s="7" t="inlineStr"><is><t>&#1571;&#1614;&#1589;&#1618;&#1576;&#1614;&#1581;&#1618;&#1606;&#1614;&#1575; &#1593;&#1614;&#1604;&#1614;&#1609; &#1601;&#1616;&#1591;&#1618;&#1585;&#1614;&#1577;&#1616; &#1575;&#1604;&#1618;&#1573;&#1616;&#1587;&#1618;&#1604;&#1614;&#1575;&#1605;&#1616;&#1548; &#1608;&#1614;&#1593;&#1614;&#1604;&#1614;&#1609; &#1603;&#1614;&#1604;&#1616;&#1605;&#1614;&#1577;&#1616; &#1575;&#1604;&#1618;&#1573;&#1616;&#1582;&#1618;&#1604;&#1614;&#1575;&#1589;&#1616;&#1548; &#1608;&#1614;&#1593;&#1614;&#1604;&#1614;&#1609; &#1583;&#1616;&#1610;&#1606;&#1616; &#1606;&#1614;&#1576;&#1616;&#1610;&#1616;&#1617;&#1606;&#1614;&#1575; &#1605;&#1615;&#1581;&#1614;&#1605;&#1614;&#1617;&#1583;&#1613; &#1589;&#1614;&#1604;&#1614;&#1617;&#1609; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1593;&#1614;&#1604;&#1614;&#1610;&#1618;&#1607;&#1616; &#1608;&#1614;&#1587;&#1614;&#1604;&#1614;&#1617;&#1605;&#1614;&#1548; &#1608;&#1614;&#1593;&#1614;&#1604;&#1614;&#1609; &#1605;&#1616;&#1604;&#1614;&#1617;&#1577;&#1616; &#1571;&#1614;&#1576;&#1616;&#1610;&#1606;&#1614;&#1575; &#1573;&#1616;&#1576;&#1618;&#1585;&#1614;&#1575;&#1607;&#1616;&#1610;&#1605;&#1614; &#1581;&#1614;&#1606;&#1616;&#1610;&#1601;&#1611;&#1575; &#1605;&#1615;&#1587;&#1618;&#1604;&#1616;&#1605;&#1611;&#1575; &#1608;&#1614;&#1605;&#1614;&#1575; &#1603;&#1614;&#1575;&#1606;&#1614; &#1605;&#1616;&#1606;&#1614; &#1575;&#1604;&#1618;&#1605;&#1615;&#1588;&#1618;&#1585;&#1616;&#1603;&#1616;&#1610;&#1606;&#1614;</t></is></c><c r="E17" s="8" t="inlineStr"><is><t>Narrated by Ubayy ibn Ka'b / others: the Prophet (SAW) would say this upon entering the morning (evening form: Amsayna...).</t></is></c><c r="F17" s="8" t="inlineStr"><is><t>We have entered the morning upon the natural disposition of Islam, the word of sincerity, the religion of our Prophet Muhammad (SAW), and the way of our father Ibrahim, who was upright, a Muslim, and not of the polytheists.</t></is></c><c r="G17" s="8" t="inlineStr"><is><t>Reaffirming Islam, sincerity, the Prophet's religion and the pure monotheism of Ibrahim each day.</t></is></c><c r="H17" s="6" t="inlineStr"><is><t>Morning</t></is></c><c r="I17" s="6" t="inlineStr"><is><t>1</t></is></c><c r="J17" s="8" t="inlineStr"><is><t>Musnad Ahmad 15360 (book's ref)</t></is></c><c r="K17" s="6" t="inlineStr"><is><t>Sahih (al-Albani, Sahih al-Jami)</t></is></c><c r="L17" s="9" t="inlineStr"><is><t>https://sunnah.com/ahmad</t></is></c></row><row r="18"><c r="A18" s="2" t="n"><v>17</v></c><c r="B18" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="C18" s="2" t="inlineStr"><is><t>Du'a</t></is></c><c r="D18" s="3" t="inlineStr"><is><t>&#1581;&#1614;&#1587;&#1618;&#1576;&#1616;&#1610;&#1614; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1615; &#1604;&#1614;&#1575; &#1573;&#1616;&#1604;&#1614;&#1607;&#1614; &#1573;&#1616;&#1604;&#1614;&#1617;&#1575; &#1607;&#1615;&#1608;&#1614; &#1593;&#1614;&#1604;&#1614;&#1610;&#1618;&#1607;&#1616; &#1578;&#1614;&#1608;&#1614;&#1603;&#1614;&#1617;&#1604;&#1618;&#1578;&#1615; &#1608;&#1614;&#1607;&#1615;&#1608;&#1614; &#1585;&#1614;&#1576;&#1615;&#1617; &#1575;&#1604;&#1618;&#1593;&#1614;&#1585;&#1618;&#1588;&#1616; &#1575;&#1604;&#1618;&#1593;&#1614;&#1592;&#1616;&#1610;&#1605;&#1616;</t></is></c><c r="E18" s="4" t="inlineStr"><is><t>Reported (mawqoof) from Abu Darda: whoever says this seven times morning and evening, Allah will suffice him in whatever concerns him.</t></is></c><c r="F18" s="4" t="inlineStr"><is><t>Allah is sufficient for me; none is worthy of worship but Him. Upon Him I rely, and He is the Lord of the Mighty Throne.</t></is></c><c r="G18" s="4" t="inlineStr"><is><t>Allah suffices the reciter in all his concerns and worries.</t></is></c><c r="H18" s="2" t="inlineStr"><is><t>Morning &amp; Evening</t></is></c><c r="I18" s="2" t="inlineStr"><is><t>7</t></is></c><c r="J18" s="4" t="inlineStr"><is><t>Sunan Abi Dawud 5081 (mawqoof from Abu Darda)</t></is></c><c r="K18" s="2" t="inlineStr"><is><t>See note (mawqoof; chain discussed)</t></is></c><c r="L18" s="5" t="inlineStr"><is><t>https://sunnah.com/abudawud:5081</t></is></c></row><row r="19"><c r="A19" s="6" t="n"><v>18</v></c><c r="B19" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="C19" s="6" t="inlineStr"><is><t>Du'a</t></is></c><c r="D19" s="7" t="inlineStr"><is><t>&#1571;&#1614;&#1593;&#1615;&#1608;&#1584;&#1615; &#1576;&#1616;&#1603;&#1614;&#1604;&#1616;&#1605;&#1614;&#1575;&#1578;&#1616; &#1575;&#1604;&#1604;&#1614;&#1617;&#1607;&#1616; &#1575;&#1604;&#1578;&#1614;&#1617;&#1575;&#1605;&#1614;&#1617;&#1575;&#1578;&#1616; &#1605;&#1616;&#1606;&#1618; &#1588;&#1614;&#1585;&#1616;&#1617; &#1605;&#1614;&#1575; &#1582;&#1614;&#1604;&#1614;&#1602;&#1614;</t></is></c><c r="E19" s="8" t="inlineStr"><is><t>Narrated by Abu Hurairah: a man complained of a scorpion sting; the Prophet (SAW) said had he recited this in the evening it would not have harmed him.</t></is></c><c r="F19" s="8" t="inlineStr"><is><t>I seek refuge in the Perfect Words of Allah from the evil of what He created.</t></is></c><c r="G19" s="8" t="inlineStr"><is><t>Protection from harm (e.g. stings and creatures) for the one who recites it in the evening.</t></is></c><c r="H19" s="6" t="inlineStr"><is><t>Evening</t></is></c><c r="I19" s="6" t="inlineStr"><is><t>3 (evening only)</t></is></c><c r="J19" s="8" t="inlineStr"><is><t>Sahih Muslim 2708, 2709 (also Hisn al-Muslim 97)</t></is></c><c r="K19" s="6" t="inlineStr"><is><t>Sahih</t></is></c><c r="L19" s="9" t="inlineStr"><is><t>https://sunnah.com/muslim:2708</t></is></c></row><row r="20"><c r="A20" s="2" t="n"><v>19</v></c><c r="B20" s="2" t="inlineStr"><is><t>Quran</t></is></c><c r="C20" s="2" t="inlineStr"><is><t>Quran</t></is></c><c r="D20" s="3" t="inlineStr"><is><t>&#1570;&#1605;&#1614;&#1606;&#1614; &#1575;&#1604;&#1585;&#1614;&#1617;&#1587;&#1615;&#1608;&#1604;&#1615; &#1576;&#1616;&#1605;&#1614;&#1575; &#1571;&#1615;&#1606;&#1618;&#1586;&#1616;&#1604;&#1614; &#1573;&#1616;&#1604;&#1614;&#1610;&#1618;&#1607;&#1616; &#1605;&#1616;&#1606;&#1618; &#1585;&#1614;&#1576;&#1616;&#1617;&#1607;&#1616; &#1608;&#1614;&#1575;&#1604;&#1618;&#1605;&#1615;&#1572;&#1618;&#1605;&#1616;&#1606;&#1615;&#1608;&#1606;&#1614;... (&#1575;&#1604;&#1576;&#1602;&#1585;&#1577; &#1634;&#1640;&#1637;-&#1634;&#1640;&#1638;)</t></is></c><c r="E20" s="4" t="inlineStr"><is><t>Narrated by Abu Mas'ud: the Prophet (SAW) said whoever recites the last two verses of Surah Al-Baqarah at night, they will suffice him. (To be recited after sunset.)</t></is></c><c r="F20" s="4" t="inlineStr"><is><t>The Messenger believes in what was revealed to him from his Lord, and so do the believers... (ends) You are our Protector, so grant us victory over the disbelieving people. (Al-Baqarah 285-286)</t></is></c><c r="G20" s="4" t="inlineStr"><is><t>Reciting these two verses at night suffices the believer as protection from all harm, including Shaytan.</t></is></c><c r="H20" s="2" t="inlineStr"><is><t>Evening</t></is></c><c r="I20" s="2" t="inlineStr"><is><t>1 (after sunset)</t></is></c><c r="J20" s="4" t="inlineStr"><is><t>Sahih al-Bukhari 4008; Sahih Muslim 807</t></is></c><c r="K20" s="2" t="inlineStr"><is><t>Sahih</t></is></c><c r="L20" s="5" t="inlineStr"><is><t>https://sunnah.com/bukhari:4008</t></is></c></row><row r="22" ht="120" customHeight="1"><c r="A22" s="10" t="inlineStr"><is><t>Source booklet: 'A Summary of the Authentic Morning &amp; Evening Adhkar' by Shaykh Abdul Aziz At-Tarefe, compiled by Yasser Peerun. Grades: Bukhari &amp; Muslim narrations are Sahih by consensus; Sunan gradings follow al-Albani / al-Tirmidhi as documented on sunnah.com and in Sahih al-Jami. Arabic is the dhikr text; the 'Dhikr in the Hadith' column paraphrases the narration context rather than reproducing the full hadith. Where the booklet cites Musnad Ahmad (not individually numbered on sunnah.com) the link points to a sunnah.com page carrying the identical du'a and the book's reference is kept in the Source column; the Ahmad 15360 link is the collection landing page only. Note on #17 (Hasbiyallah, 7x): this is reported as a saying of Abu Darda (mawqoof), not a direct marfu' hadith; scholars differ on its chain &#8212; treat the '7 times' practice with that in mind. All links checked against the hadith text on 22 Aug 2026.</t></is></c></row></sheetData><mergeCells count="1"><mergeCell ref="A22:L22"/></mergeCells><hyperlinks><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L2" r:id="rId1"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L3" r:id="rId2"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L4" r:id="rId3"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L5" r:id="rId4"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L6" r:id="rId5"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L7" r:id="rId6"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L8" r:id="rId7"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L9" r:id="rId8"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L10" r:id="rId9"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L11" r:id="rId10"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L12" r:id="rId11"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L13" r:id="rId12"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L14" r:id="rId13"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L15" r:id="rId14"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L16" r:id="rId15"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L17" r:id="rId16"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L18" r:id="rId17"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L19" r:id="rId18"/><hyperlink xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ref="L20" r:id="rId19"/></hyperlinks><pageMargins left="0.75" right="0.75" top="1" bottom="1" header="0.5" footer="0.5"/></worksheet>